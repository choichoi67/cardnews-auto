.env
.venv/
.tools/
__pycache__/
*.pyc
credentials.json
token.json
output/*
!output/.gitkeep
state/*
!state/.gitkeep
# Channel settings stay private: prompts, Drive folder, Telegram chat, PC paths (see config.example.yaml)
config.yaml
magazines/
